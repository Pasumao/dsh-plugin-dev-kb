    "documentation-mirror",
    "kb",
    "plugin-development",
    "agent-skills",
    "skills",
    "retrieval",
    "rag"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pasumao/dsh-plugin-dev-kb.git"
  },
  "homepage": "https://github.com/Pasumao/dsh-plugin-dev-kb",
